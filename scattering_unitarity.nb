         SqrtBox["2"]], 
        RowBox[{"(", 
         RowBox[{"\[Phi]20r", "+", 
          RowBox[{"I", " ", "\[Phi]20i"}]}], ")"}]}]}
     }], ")"}]}], ";", 
  RowBox[{"chiL", "=", 
   RowBox[{"(", GridBox[{
      {"chiLp"},
      {
       RowBox[{
        FractionBox["1", 
         SqrtBox["2"]], 
        RowBox[{"(", 
         RowBox[{"chiL0r", "+", 
          RowBox[{"I", " ", "chiL0i"}]}], ")"}]}]}
     }], ")"}]}], ";", 
  RowBox[{"chiR", "=", 
   RowBox[{"(", GridBox[{
      {"chiRp"},
      {
       RowBox[{
        FractionBox["1", 
         SqrtBox["2"]], 
        RowBox[{"(", 
         RowBox[{"chiR0r", "+", 
          RowBox[{"I", " ", "chiR0i"}]}], ")"}]}]}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]", "=", 
    RowBox[{"(", GridBox[{
       {"0", 
        RowBox[{"-", "I"}]},
       {"I", "0"}
      }], ")"}]}], ";", 
   RowBox[{"\[Phi]t", " ", "=", " ", 
    RowBox[{"\[Sigma]", ".", 
     RowBox[{"Conjugate", "[", "\[Phi]", "]"}], ".", "\[Sigma]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Vpot", "=", "   ", 
