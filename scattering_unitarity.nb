 RowBox[{
  RowBox[{
   RowBox[{"NCSymFac", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"NCfacList", "[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Equal]", "2"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"Factorial", "[", "4", "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"NCfacList", "[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Equal]", "3"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"NCfacList", "[", 
              RowBox[{"i", ",", "j"}], "]"}], ")"}], "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2"}], "]"}], "]"}], "\[Equal]", "2"}], "&&", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"NCfacList", "[", 
              RowBox[{"i", ",", "j"}], "]"}], ")"}], "[", 
            RowBox[{"[", 
             RowBox[{"3", ",", "2"}], "]"}], "]"}], "\[Equal]", "2"}]}], ",", 
         
         RowBox[{"Return", "[", "4", "]"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"Factorial", "[", "3", "]"}], "]"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
