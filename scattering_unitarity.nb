Cell[BoxData[{
 RowBox[{
  RowBox[{"NCfacList", "[", 
   RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
  RowBox[{"FactorList", "[", 
   RowBox[{
    RowBox[{"NCColumn", "[", 
     RowBox[{"[", "i", "]"}], "]"}], " ", 
    RowBox[{"NCRow", "[", 
     RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NCSymFac", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"NCfacList", "[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Equal]", "2"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"Factorial", "[", "4", "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"NCfacList", "[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Equal]", "3"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"NCfacList", "[", 
              RowBox[{"i", ",", "j"}], "]"}], ")"}], "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2"}], "]"}], "]"}], "\[Equal]", "2"}], "&&", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"NCfacList", "[", 
              RowBox[{"i", ",", "j"}], "]"}], ")"}], "[", 
            RowBox[{"[", 
             RowBox[{"3", ",", "2"}], "]"}], "]"}], "\[Equal]", "2"}]}], ",", 
         
         RowBox[{"Return", "[", "4", "]"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"Factorial", "[", "3", "]"}], "]"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"NCfacList", "[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Equal]", "4"}], ",", 
       RowBox[{"Return", "[", "2", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"NCfacList", "[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Equal]", "5"}], ",", 
       RowBox[{"Return", "[", "1", "]"}]}], "]"}]}], ")"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NCcoeff", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"Coefficient", "[", 
    RowBox[{"Vtot", ",", 
     RowBox[{
      RowBox[{"NCColumn", "[", 
       RowBox[{"[", "i", "]"}], "]"}], " ", 
      RowBox[{"NCRow", "[", 
       RowBox[{"[", "j", "]"}], "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"IdenticalQ", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f", "=", 
       RowBox[{"FactorList", "[", "expr", "]"}]}], "}"}], ",", 
     RowBox[{"AnyTrue", "[", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"[", 
         RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "==", "2"}], "&"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"NormFactor", "[", "expr_", "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"IdenticalQ", "[", "expr", "]"}], ",", 
      RowBox[{"Sqrt", "[", "2", "]"}], ",", "1"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NCMatFunc", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"NCSymFac", "[", 
     RowBox[{"i", ",", "j"}], "]"}], "*", 
    RowBox[{
     RowBox[{"NCcoeff", "[", 
      RowBox[{"i", ",", "j"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"NormFactor", "[", 
        RowBox[{"NCColumn", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], " ", 
       RowBox[{"NormFactor", "[", 
        RowBox[{"NCRow", "[", 
         RowBox[{"[", "j", "]"}], "]"}], "]"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"i", "=", "1"}], ";", 
      RowBox[{"NCklist", "=", 
       RowBox[{"{", "}"}]}]}], ",", 
     RowBox[{"i", "\[LessEqual]", " ", "52"}], ",", 
     RowBox[{"i", "++"}], ",", 
     RowBox[{
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"j", "=", "1"}], ";", 
         RowBox[{"NCjlist", "=", 
          RowBox[{"{", "}"}]}]}], ",", 
        RowBox[{"j", "\[LessEqual]", " ", "52"}], ",", 
        RowBox[{"j", "++"}], ",", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"NCjlist", ",", 
          RowBox[{"{", 
           RowBox[{"NCMatFunc", "[", 
            RowBox[{"i", ",", "j"}], "]"}], "}"}]}], "]"}]}], "]"}], ";", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"NCklist", ",", 
        RowBox[{"Flatten", "[", "NCjlist", "]"}]}], "]"}]}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NCklist1", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"NCMatFunc", "[", 
       RowBox[{"i", ",", "j"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "52"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "52"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NCklist", "//", "MatrixForm"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
