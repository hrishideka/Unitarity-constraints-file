Cell["\<\
We begin by describing the scalar potential of the ALRM, and then construct \
the scattering matrices for q-charged two-particle states using an \
appropriately defined basis. We follow the literature PhysRevD.92.096005
\
\>", "Subtitle",
 CellChangeTimes->{{3.6471601504726753`*^9, 3.6471601534269238`*^9}, {
