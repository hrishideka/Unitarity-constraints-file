Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"DCcoeff", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"Coefficient", "[", 
    RowBox[{"Vtot", ",", 
     RowBox[{
      RowBox[{"DCColumn", "[", 
       RowBox[{"[", "i", "]"}], "]"}], " ", 
      RowBox[{"DCRow", "[", 
       RowBox[{"[", "j", "]"}], "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"IdenticalQDC", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f", "=", 
       RowBox[{"FactorList", "[", "expr", "]"}]}], "}"}], ",", 
     RowBox[{"AnyTrue", "[", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"[", 
         RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "==", "2"}], "&"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"NormFactorDC", "[", "expr_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"IdenticalQDC", "[", "expr", "]"}], ",", 
     RowBox[{"Sqrt", "[", "2", "]"}], ",", "1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DCMatFunc", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"DCSymFac", "[", 
     RowBox[{"i", ",", "j"}], "]"}], "*", 
    RowBox[{
     RowBox[{"DCcoeff", "[", 
      RowBox[{"i", ",", "j"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"NormFactorDC", "[", 
        RowBox[{"DCColumn", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], " ", 
       RowBox[{"NormFactorDC", "[", 
        RowBox[{"DCRow", "[", 
         RowBox[{"[", "j", "]"}], "]"}], "]"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.6253767010021677`*^9, 3.6253767106232777`*^9}, {
