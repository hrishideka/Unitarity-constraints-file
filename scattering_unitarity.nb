Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CCfacList", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"FactorList", "[", 
    RowBox[{
     RowBox[{"CCColumn", "[", 
      RowBox[{"[", "i", "]"}], "]"}], " ", 
     RowBox[{"CCRow", "[", 
      RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CCSymFac", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"CCfacList", "[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Equal]", "2"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"Factorial", "[", "4", "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"CCfacList", "[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Equal]", "3"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"CCfacList", "[", 
              RowBox[{"i", ",", "j"}], "]"}], ")"}], "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2"}], "]"}], "]"}], "\[Equal]", "2"}], "&&", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"CCfacList", "[", 
              RowBox[{"i", ",", "j"}], "]"}], ")"}], "[", 
            RowBox[{"[", 
             RowBox[{"3", ",", "2"}], "]"}], "]"}], "\[Equal]", "2"}]}], ",", 
         
         RowBox[{"Return", "[", "4", "]"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"Factorial", "[", "3", "]"}], "]"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"CCfacList", "[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Equal]", "4"}], ",", 
       RowBox[{"Return", "[", "2", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"CCfacList", "[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Equal]", "5"}], ",", 
       RowBox[{"Return", "[", "1", "]"}]}], "]"}]}], ")"}]}], ";"}]}], "Input",\

 CellLabel->"In[24]:=",ExpressionUUID->"f990446e-9ae4-43ce-a4ba-4d6c7b8d275d"],

