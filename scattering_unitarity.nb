Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CCfacList", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"FactorList", "[", 
    RowBox[{
     RowBox[{"CCColumn", "[", 
      RowBox[{"[", "i", "]"}], "]"}], " ", 
     RowBox[{"CCRow", "[", 
      RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"CCSymFac", "[", 
     RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"CCfacList", "[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Equal]", "2"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Factorial", "[", "4", "]"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"CCfacList", "[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Equal]", "3"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"CCfacList", "[", 
               RowBox[{"i", ",", "j"}], "]"}], ")"}], "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2"}], "]"}], "]"}], "\[Equal]", "2"}], "&&", 
           
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"CCfacList", "[", 
               RowBox[{"i", ",", "j"}], "]"}], ")"}], "[", 
             RowBox[{"[", 
              RowBox[{"3", ",", "2"}], "]"}], "]"}], "\[Equal]", "2"}]}], ",", 
          RowBox[{"Return", "[", "4", "]"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Factorial", "[", "3", "]"}], "]"}]}], "]"}]}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"CCfacList", "[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Equal]", "4"}], ",", 
        RowBox[{"Return", "[", "2", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"CCfacList", "[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Equal]", "5"}], ",", 
        RowBox[{"Return", "[", "1", "]"}]}], "]"}]}], ")"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CCcoeff", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"Coefficient", "[", 
    RowBox[{"Vtot", ",", 
     RowBox[{
      RowBox[{"CCColumn", "[", 
       RowBox[{"[", "i", "]"}], "]"}], " ", 
      RowBox[{"CCRow", "[", 
       RowBox[{"[", "j", "]"}], "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"IdenticalQCC", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f", "=", 
       RowBox[{"FactorList", "[", "expr", "]"}]}], "}"}], ",", 
     RowBox[{"AnyTrue", "[", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"[", 
         RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "==", "2"}], "&"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"NormFactorCC", "[", "expr_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"IdenticalQCC", "[", "expr", "]"}], ",", 
     RowBox[{"Sqrt", "[", "2", "]"}], ",", "1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"CCMatFunc", "[", 
     RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"CCSymFac", "[", 
      RowBox[{"i", ",", "j"}], "]"}], "*", 
     RowBox[{
      RowBox[{"CCcoeff", "[", 
       RowBox[{"i", ",", "j"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"NormFactorCC", "[", 
         RowBox[{"CCColumn", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}], " ", 
        RowBox[{"NormFactorCC", "[", 
         RowBox[{"CCRow", "[", 
          RowBox[{"[", "j", "]"}], "]"}], "]"}]}], ")"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"i", "=", "1"}], ";", 
     RowBox[{"CCklist", "=", 
      RowBox[{"{", "}"}]}]}], ",", 
    RowBox[{"i", "\[LessEqual]", " ", "32"}], ",", 
    RowBox[{"i", "++"}], ",", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"j", "=", "1"}], ";", 
        RowBox[{"CCjlist", "=", 
         RowBox[{"{", "}"}]}]}], ",", 
       RowBox[{"j", "\[LessEqual]", " ", "32"}], ",", 
       RowBox[{"j", "++"}], ",", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"CCjlist", ",", 
         RowBox[{"{", 
          RowBox[{"CCMatFunc", "[", 
           RowBox[{"i", ",", "j"}], "]"}], "}"}]}], "]"}]}], "]"}], 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"CCklist", ",", 
       RowBox[{"Flatten", "[", "CCjlist", "]"}]}], "]"}]}]}], "]"}], 
  ";"}], "\n", 
