Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Phi]", "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{
        FractionBox["1", 
         SqrtBox["2"]], 
        RowBox[{"(", 
         RowBox[{"\[Phi]10r", "+", 
          RowBox[{"I", "  ", "\[Phi]10i"}]}], ")"}]}], "\[Phi]1p"},
      {"\[Phi]2m", 
