Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Phi]", "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{
        FractionBox["1", 
         SqrtBox["2"]], 
        RowBox[{"(", 
         RowBox[{"\[Phi]10r", "+", 
          RowBox[{"I", "  ", "\[Phi]10i"}]}], ")"}]}], "\[Phi]1p"},
      {"\[Phi]2m", 
       RowBox[{
        FractionBox["1", 
         SqrtBox["2"]], 
        RowBox[{"(", 
         RowBox[{"\[Phi]20r", "+", 
          RowBox[{"I", " ", "\[Phi]20i"}]}], ")"}]}]}
     }], ")"}]}], ";", 
  RowBox[{"chiL", "=", 
   RowBox[{"(", GridBox[{
      {"chiLp"},
      {
       RowBox[{
        FractionBox["1", 
         SqrtBox["2"]], 
        RowBox[{"(", 
         RowBox[{"chiL0r", "+", 
          RowBox[{"I", " ", "chiL0i"}]}], ")"}]}]}
     }], ")"}]}], ";", 
  RowBox[{"chiR", "=", 
   RowBox[{"(", GridBox[{
      {"chiRp"},
      {
       RowBox[{
        FractionBox["1", 
         SqrtBox["2"]], 
        RowBox[{"(", 
         RowBox[{"chiR0r", "+", 
          RowBox[{"I", " ", "chiR0i"}]}], ")"}]}]}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]", "=", 
    RowBox[{"(", GridBox[{
       {"0", 
        RowBox[{"-", "I"}]},
       {"I", "0"}
      }], ")"}]}], ";", 
   RowBox[{"\[Phi]t", " ", "=", " ", 
    RowBox[{"\[Sigma]", ".", 
     RowBox[{"Conjugate", "[", "\[Phi]", "]"}], ".", "\[Sigma]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Vpot", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "mu12"}], 
       RowBox[{"(", 
        RowBox[{"Tr", "[", 
         RowBox[{
          RowBox[{"\[Phi]", "\[ConjugateTranspose]"}], ".", "\[Phi]"}], "]"}],
         ")"}]}], " ", "+", "  ", 
      RowBox[{
       SubscriptBox["\[Lambda]", "1"], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"\[Phi]", "\[ConjugateTranspose]"}], ".", "\[Phi]"}], 
          "]"}], ")"}], "2"]}], " ", "+", " ", 
      RowBox[{
       SubscriptBox["\[Lambda]", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Tr", "[", 
           RowBox[{
            RowBox[{"\[Phi]", "\[ConjugateTranspose]"}], ".", "\[Phi]t"}], 
           "]"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"Tr", "[", 
           RowBox[{
            RowBox[{"\[Phi]t", "\[ConjugateTranspose]"}], ".", "\[Phi]"}], 
           "]"}], ")"}]}], ")"}]}], " ", "-", 
      RowBox[{"mu22", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"chiL", "\[ConjugateTranspose]"}], ".", "chiL"}], "+", 
         RowBox[{
          RowBox[{"chiR", "\[ConjugateTranspose]"}], ".", "chiR"}]}], ")"}]}],
       "+", " ", 
      RowBox[{
       SubscriptBox["\[Lambda]", "3"], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"chiL", "\[ConjugateTranspose]"}], ".", "chiL"}], ")"}], 
          "2"], "+", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"chiR", "\[ConjugateTranspose]"}], ".", "chiR"}], ")"}], 
          "2"]}], ")"}]}], "      ", "+", 
      RowBox[{"2", 
       SubscriptBox["\[Lambda]", "4"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"chiL", "\[ConjugateTranspose]"}], ".", "chiL"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"chiR", "\[ConjugateTranspose]"}], ".", "chiR"}], ")"}]}], 
      " ", "+", " ", 
      RowBox[{"2", 
       SubscriptBox["\[Alpha]", "1"], 
       RowBox[{"(", 
        RowBox[{"Tr", "[", 
         RowBox[{
          RowBox[{"\[Phi]", "\[ConjugateTranspose]"}], ".", "\[Phi]"}], "]"}],
         ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"chiL", "\[ConjugateTranspose]"}], ".", "chiL"}], "+", 
         RowBox[{
          RowBox[{"chiR", "\[ConjugateTranspose]"}], ".", "chiR"}]}], ")"}]}],
       " ", "+", " ", 
      RowBox[{"2", 
       SubscriptBox["\[Alpha]", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"chiL", "\[ConjugateTranspose]"}], ".", "\[Phi]", ".", 
          RowBox[{"\[Phi]", "\[ConjugateTranspose]"}], ".", "chiL"}], "+", 
         RowBox[{
          RowBox[{"chiR", "\[ConjugateTranspose]"}], ".", 
          RowBox[{"\[Phi]", "\[ConjugateTranspose]"}], ".", "\[Phi]", ".", 
          "chiR"}]}], ")"}]}], "   ", "+", " ", 
      RowBox[{"2", 
       SubscriptBox["\[Alpha]", "3"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"chiL", "\[ConjugateTranspose]"}], ".", "\[Phi]t", ".", 
          RowBox[{"\[Phi]t", "\[ConjugateTranspose]"}], ".", "ch"}], ",", 
         RowBox[{"iL", "+", 
          RowBox[{
           RowBox[{"chiR", "\[ConjugateTranspose]"}], ".", 
           RowBox[{"\[Phi]t", "\[ConjugateTranspose]"}], ".", "\[Phi]t", ".", 
           "chiR"}]}]}], ")"}]}], "  ", "+", " ", 
      RowBox[{"mu3", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"chiL", "\[ConjugateTranspose]"}], ".", "\[Phi]", ".", 
          "chiR"}], "+", 
         RowBox[{
          RowBox[{"chiR", "\[ConjugateTranspose]"}], ".", 
          RowBox[{"\[Phi]", "\[ConjugateTranspose]"}], ".", "chiL"}]}], 
        ")"}]}]}]}], ";"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Vpot", "=", "   ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Lambda]", "1"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"Tr", "[", 
         RowBox[{
          RowBox[{"\[Phi]", "\[ConjugateTranspose]"}], ".", "\[Phi]"}], "]"}],
         ")"}], "2"]}], " ", "+", " ", 
     RowBox[{
      SubscriptBox["\[Lambda]", "2"], 
      RowBox[{"(", 
