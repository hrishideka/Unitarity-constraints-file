 RowBox[{
  RowBox[{
   RowBox[{"IdenticalQDC", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f", "=", 
       RowBox[{"FactorList", "[", "expr", "]"}]}], "}"}], ",", 
     RowBox[{"AnyTrue", "[", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"[", 
         RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "==", "2"}], "&"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"NormFactorDC", "[", "expr_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"IdenticalQDC", "[", "expr", "]"}], ",", 
     RowBox[{"Sqrt", "[", "2", "]"}], ",", "1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DCMatFunc", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
