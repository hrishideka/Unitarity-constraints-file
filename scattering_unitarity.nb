Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"DCfacList", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"FactorList", "[", 
    RowBox[{
     RowBox[{"DCColumn", "[", 
      RowBox[{"[", "i", "]"}], "]"}], " ", 
     RowBox[{"DCRow", "[", 
      RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DCSymFac", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"DCfacList", "[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Equal]", "2"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"Factorial", "[", "4", "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"DCfacList", "[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Equal]", "3"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"DCfacList", "[", 
              RowBox[{"i", ",", "j"}], "]"}], ")"}], "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2"}], "]"}], "]"}], "\[Equal]", "2"}], "&&", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"DCfacList", "[", 
              RowBox[{"i", ",", "j"}], "]"}], ")"}], "[", 
            RowBox[{"[", 
             RowBox[{"3", ",", "2"}], "]"}], "]"}], "\[Equal]", "2"}]}], ",", 
         
         RowBox[{"Return", "[", "4", "]"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"Factorial", "[", "3", "]"}], "]"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"DCfacList", "[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Equal]", "4"}], ",", 
       RowBox[{"Return", "[", "2", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"DCfacList", "[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Equal]", "5"}], ",", 
       RowBox[{"Return", "[", "1", "]"}]}], "]"}]}], ")"}]}], ";"}]}], "Input",\

