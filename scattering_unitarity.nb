           RowBox[{"\[Phi]", "\[ConjugateTranspose]"}], ".", "\[Phi]t"}], 
          "]"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"\[Phi]t", "\[ConjugateTranspose]"}], ".", "\[Phi]"}], 
          "]"}], ")"}]}], ")"}]}], " ", "+", " ", 
     RowBox[{
      SubscriptBox["\[Lambda]", "3"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"chiL", "\[ConjugateTranspose]"}], ".", "chiL"}], ")"}], 
         "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"chiR", "\[ConjugateTranspose]"}], ".", "chiR"}], ")"}], 
         "2"]}], ")"}]}], "      ", "+", 
     RowBox[{"2", 
      SubscriptBox["\[Lambda]", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"chiL", "\[ConjugateTranspose]"}], ".", "chiL", ".", 
        RowBox[{"chiR", "\[ConjugateTranspose]"}], ".", "chiR"}], ")"}]}], 
     "  ", "+", " ", 
     RowBox[{"2", 
      SubscriptBox["\[Alpha]", "12"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"chiL", "\[ConjugateTranspose]"}], ".", "\[Phi]", ".", 
         RowBox[{"\[Phi]", "\[ConjugateTranspose]"}], ".", "chiL"}], "+", 
        RowBox[{
         RowBox[{"chiR", "\[ConjugateTranspose]"}], ".", 
         RowBox[{"\[Phi]", "\[ConjugateTranspose]"}], ".", "\[Phi]", ".", 
         "chiR"}]}], ")"}]}], "   ", "+", " ", 
     RowBox[{"2", 
      SubscriptBox["\[Alpha]", "13"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"chiL", "\[ConjugateTranspose]"}], ".", "\[Phi]t", ".", 
         RowBox[{"\[Phi]t", "\[ConjugateTranspose]"}], ".", "chiL"}], "+", 
        RowBox[{
         RowBox[{"chiR", "\[ConjugateTranspose]"}], ".", 
         RowBox[{"\[Phi]t", "\[ConjugateTranspose]"}], ".", "\[Phi]t", ".", 
         "chiR"}]}], ")"}]}]}]}], "  ", ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Here", ",", " ", 
    RowBox[{
    "we", " ", "write", " ", "only", " ", "the", " ", "quartic", " ", 
     "terms"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"               "}]}], "Input",
