Cell[BoxData[{
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"i", "=", "1"}], ";", 
     RowBox[{"DCklist", "=", 
      RowBox[{"{", "}"}]}]}], ",", 
    RowBox[{"i", "\[LessEqual]", " ", "10"}], ",", 
    RowBox[{"i", "++"}], ",", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"j", "=", "1"}], ";", 
        RowBox[{"DCjlist", "=", 
         RowBox[{"{", "}"}]}]}], ",", 
       RowBox[{"j", "\[LessEqual]", " ", "10"}], ",", 
       RowBox[{"j", "++"}], ",", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"DCjlist", ",", 
         RowBox[{"{", 
          RowBox[{"DCMatFunc", "[", 
           RowBox[{"i", ",", "j"}], "]"}], "}"}]}], "]"}]}], "]"}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"DCklist", ",", 
       RowBox[{"Flatten", "[", "DCjlist", "]"}]}], "]"}]}]}], "]"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"DCklist", "//", "MatrixForm"}], ";"}], "*)"}]}], "\n", 
